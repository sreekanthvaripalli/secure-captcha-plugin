# Shopify API credentials
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_API_SCOPES=write_script_tags,read_orders,write_orders

# App URL (ngrok or production URL)
SHOPIFY_APP_URL=https://your-app-url.ngrok-free.app

# Secure CAPTCHA API URL
CAPTCHA_API_URL=http://localhost:3000/api/v1/captcha

# Server port
PORT=3000