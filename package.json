{
  "name": "secure-captcha-plugin",
  "version": "1.0.0",
  "description": "Enterprise-grade, non-crackable CAPTCHA solution with lightning-fast performance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "test:security": "jest tests/security --passWithNoTests",
    "test:performance": "jest tests/performance --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit && snyk test",
    "prepare": "husky install",
    "clean": "rm -rf dist coverage",
    "docker:build": "docker build -t secure-captcha-plugin .",
    "docker:run": "docker run -p 3000:3000 secure-captcha-plugin"
  },
  "keywords": [
    "captcha",
    "security",
    "authentication",
    "anti-bot",
    "cybersecurity",
    "enterprise",
    "non-crackable",
    "high-performance"
  ],
  "author": "Secure Captcha Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@types/pg": "^8.20.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "graphql": "^16.13.2",
    "graphql-http": "^1.22.4",
    "graphql-subscriptions": "^3.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.2",
    "uuid": "^9.0.1",
    "vue": "^3.4.15",
    "winston": "^3.11.0",
    "winston-elasticsearch": "^0.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@angular/common": "^19.2.18",
    "@angular/compiler": "^19.2.18",
    "@angular/compiler-cli": "^19.2.18",
    "@angular/core": "^19.2.18",
    "@angular/forms": "^19.2.18",
    "@angular/platform-browser": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@nestjs/testing": "^11.1.17",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^3.0.2",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.2",
    "snyk": "^1.1260.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vue": "^3.4.15",
    "zone.js": "^0.15.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sreekanthvaripalli/secure-captcha-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sreekanthvaripalli/secure-captcha-plugin/issues"
  },
  "homepage": "https://github.com/sreekanthvaripalli/secure-captcha-plugin#readme",
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "@angular/forms": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  }
}
