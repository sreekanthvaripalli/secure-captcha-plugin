{
  "name": "secure-captcha-plugin",
  "version": "1.0.0",
  "description": "Enterprise-grade, non-crackable CAPTCHA solution with lightning-fast performance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "test:security": "jest tests/security --passWithNoTests",
    "test:performance": "jest tests/performance --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "security:audit": "npm audit && snyk test",
    "prepare": "husky install",
    "clean": "rm -rf dist coverage",
    "docker:build": "docker build -t secure-captcha-plugin .",
    "docker:run": "docker run -p 3000:3000 secure-captcha-plugin"
  },
  "keywords": [
    "captcha",
    "security",
    "authentication",
    "anti-bot",
    "cybersecurity",
    "enterprise",
    "non-crackable",
    "high-performance"
  ],
  "author": "Secure Captcha Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "sharp": "^0.33.2",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "prom-client": "^15.1.0",
    "bull": "^4.12.0",
    "@tensorflow/tfjs-node": "^4.17.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/sharp": "^0.31.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint-plugin-security": "^2.1.0",
    "prettier": "^3.2.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "snyk": "^1.1260.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sreekanthvaripalli/secure-captcha-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sreekanthvaripalli/secure-captcha-plugin/issues"
  },
  "homepage": "https://github.com/sreekanthvaripalli/secure-captcha-plugin#readme"
}